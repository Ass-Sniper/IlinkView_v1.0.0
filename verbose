 (status == STAT_SUCCESS && response->errstat == SNMP_ERR_NOERROR) {\n        struct variable_list *vars = response->variables;\n        snprintf(value, max_len, \"%s\", vars->val.string);\n        snmp_free_pdu(response);\n        return 0;\n    }\n    if (response) snmp_free_pdu(response);\n    return -1;\n}\n\nint snmp_set(snmp_session_t* s, const char* oid_str, const char* value) {\n    // 简化示例，可根据类型扩展\n    return 0;\n}\n\nvoid snmp_close(snmp_session_t* s) {\n    if (!s) return;\n    if (s->ss) snmp_close(s->ss);\n    free(s);\n}\n","uri":"file:///home/kay/codebase/test/IlinkView_v1.0.0/src/snmp_manager.c","version":3}}}},{"pid":0,"ph":"X","name":"WaitForFreeSemaphoreSlot","ts":45886.212,"tid":327309,"dur":446168.68300000002,"args":{}},{"pid":0,"ph":"s","name":"Context crosses threads","ts":41786.167000000001,"tid":327284,"id":18,"cat":"mock_cat"},{"pid":0,"ph":"f","name":"Context crosses threads","ts":492081.95699999999,"tid":327309,"bp":"e","id":18,"cat":"mock_cat"},{"pid":0,"ph":"X","name":"getConfig","ts":492087.364,"tid":327309,"dur":8.0790000000270084,"args":{"path":"/home/kay/codebase/test/IlinkView_v1.0.0/app/business_logic.cpp"}},{"pid":0,"ph":"X","name":"getConfig","ts":492105.08399999997,"tid":327309,"dur":4.7630000000353903,"args":{"path":"/home/kay/codebase/test/IlinkView_v1.0.0/app/business_logic.cpp"}},{"pid":0,"ph":"i","name":"Log","ts":492130.71600000001,"tid":327309,"args":{"Message":"Failed to find compilation database for /home/kay/codebase/test/IlinkView_v1.0.0/app/business_logic.cpp"}},{"pid":0,"ph":"X","name":"AdjustCompileFlags","ts":492156.25400000002,"tid":327309,"dur":40.273999999975786,"args":{}},{"pid":0,"ph":"i","name":"Log","ts":492213.53700000001,"tid":327309,"args":{"Message":"ASTWorker building file /home/kay/codebase/test/IlinkView_v1.0.0/app/business_logic.cpp version 3 with command clangd fallback\n[/home/kay/codebase/test/IlinkView_v1.0.0/app]\n/usr/lib/llvm-10/bin/clang -resource-dir=/usr/lib/llvm-17/lib/clang/17 -- /home/